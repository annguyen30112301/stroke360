---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { getContent, pageHref, localized, asset, type PageKey, type RouteKey } from "../lib/i18n";
import { contact, site } from "../content/shared";
import type { Lang } from "../content/types";

interface Props {
  lang: Lang;
  route: RouteKey;
  lessonId?: string;
  title: string;
  description: string;
}
const { lang, route, lessonId, title, description } = Astro.props;
const c = getContent(lang);
const other: Lang = lang === "vi" ? "en" : "vi";
const abs = (l: Lang) => new URL(localized(l, route, lessonId), Astro.site).toString();
const og = new URL(asset("og.png"), Astro.site).toString();
const tel = "tel:" + contact.hotline.replace(/\s/g, "");
const active: PageKey = route === "lesson" ? "hoc" : route;
const label = (k: PageKey) => (k === "home" ? c.ui.tabs.home : c.ui.nav[k as keyof typeof c.ui.nav] ?? c.ui.footer.links[k as keyof typeof c.ui.footer.links]);

const desktopNav: PageKey[] = ["home", "hoc", "congDong", "dichVu", "tacDong", "benhVien"];
const tabs: { k: PageKey; icon: string }[] = [
  { k: "home", icon: "home" }, { k: "hoc", icon: "book" }, { k: "dichVu", icon: "care" }, { k: "congDong", icon: "community" }
];
const morePages: PageKey[] = ["tacDong", "benhVien", "nhatKy", "tuyenDung", "lienHe"];
const moreIcons: Record<string, string> = { tacDong: "trend", benhVien: "hospital", nhatKy: "notebook", tuyenDung: "nurse", lienHe: "chat" };
const moreActive = morePages.includes(active);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0FA9A6" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#071a1b" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={asset("favicon.ico")} sizes="any" />
  <link rel="icon" href={asset("favicon-512.png")} type="image/png" />
  <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
  <link rel="canonical" href={abs(lang)} />
  <link rel="alternate" hreflang="vi" href={abs("vi")} />
  <link rel="alternate" hreflang="en" href={abs("en")} />
  <link rel="alternate" hreflang="x-default" href={abs("vi")} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={abs(lang)} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <ClientRouter fallback="swap" />
</head>
<body class="min-h-dvh pb-24 lg:pb-0">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-accent focus:px-5 focus:py-3 focus:text-on-accent">{c.ui.skip}</a>
  <div aria-hidden="true" class="scroll-progress pointer-events-none fixed inset-x-0 top-0 z-[60] h-[3px]" style="background: var(--brand-grad)"></div>

  <!-- Top bar: floating capsule on desktop, slim bar on phones -->
  <header class="pointer-events-none fixed inset-x-0 top-0 z-50 pt-3 lg:pt-4" style="view-transition-name: site-nav">
    <div class="shell">
      <div class="pointer-events-auto flex h-16 items-center justify-between gap-3 rounded-full border border-hair/70 bg-raised/95 pl-4 pr-2 shadow-[var(--shadow)]">
        <a href={pageHref(lang, "home")} class="flex shrink-0 items-center rounded-full" aria-label="STROKE360">
          <img src={asset("logo-tight.png")} alt="Stroke360" width="782" height="239" class="h-11 w-auto sm:h-12 dark:rounded-xl dark:bg-white dark:px-2 dark:py-1" />
        </a>
        <nav class="hidden items-center lg:flex" aria-label="Main">
          {desktopNav.map((k) => (
            <a href={pageHref(lang, k)} aria-current={k === active ? "page" : undefined}
              class:list={["relative whitespace-nowrap rounded-full px-2.5 py-2 text-[0.92rem] font-medium no-underline transition-colors xl:px-4", k === active ? "text-accent-ink" : "text-ink-2 hover:text-ink"]}>
              {k === active && <span class="absolute inset-0 -z-10 rounded-full bg-tint" style="view-transition-name: nav-pill"></span>}
              {label(k)}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-1.5">
          <a href={localized(other, route, lessonId)} hreflang={other} lang={other} aria-label={c.ui.switchLangAria}
            class="inline-flex h-11 items-center gap-1.5 rounded-full px-3.5 text-sm font-semibold text-ink-2 no-underline hover:bg-tint hover:text-accent-ink">
            <Icon name="lang" size={18} />{other.toUpperCase()}
          </a>
          <a href={pageHref(lang, "lienHe")} class="btn btn-accent hidden !min-h-11 sm:inline-flex lg:hidden xl:inline-flex">{c.ui.headerCta}</a>
        </div>
      </div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="bg-deep text-teal-50/80">
    <div class="shell grid gap-12 pb-28 pt-20 lg:grid-cols-[1.3fr_1fr_1fr] lg:pb-16">
      <div>
        <p class="max-w-md text-[clamp(1.27rem,0.94rem+1.19vw,1.87rem)] font-bold leading-tight tracking-tight text-white">{c.ui.footer.tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={tel} class="btn btn-light"><Icon name="phone" size={20} weight="fill" />{contact.hotline}</a>
          <a href={contact.zaloGroup} target="_blank" rel="noopener" class="btn bg-white/10 text-white hover:bg-white/15">{c.ui.zalo}</a>
        </div>
      </div>
      <nav aria-label={c.ui.footer.explore}>
        <h2 class="mb-4 text-sm font-semibold text-teal-300">{c.ui.footer.explore}</h2>
        <ul class="grid gap-2.5">
          {Object.entries(c.ui.footer.links).map(([k, t]) => (
            <li><a href={pageHref(lang, k as PageKey)} class="text-teal-50/85 no-underline hover:text-white">{t}</a></li>
          ))}
        </ul>
      </nav>
      <div>
        <h2 class="mb-4 text-sm font-semibold text-teal-300">{c.ui.footer.contact}</h2>
        <ul class="grid gap-3">
          <li><a href={`mailto:${contact.email}`} class="text-teal-50/85 no-underline hover:text-white">{contact.email}</a></li>
          <li>{c.ui.footer.city}</li>
        </ul>
        <img src={asset("logo-tight.png")} alt="Stroke360" width="782" height="239" loading="lazy" data-logo="negative" class="mt-10 h-20 w-auto brightness-0 invert sm:h-24" />
      </div>
    </div>
    <p class="shell border-t border-white/10 pb-28 pt-6 text-[0.8rem] leading-relaxed text-teal-50/55 lg:pb-8">{c.ui.footer.demo} {c.lessonDisclaimer}</p>
  </footer>

  <!-- Desktop quick contact -->
  <div class="no-print fixed bottom-6 right-6 z-40 hidden flex-col gap-3 lg:flex" transition:persist="fab">
    <a href={contact.zaloGroup} target="_blank" rel="noopener" aria-label={c.ui.zalo}
      class="grid size-14 place-items-center rounded-full bg-zalo text-sm font-bold text-white no-underline shadow-lg shadow-black/20 transition hover:scale-105">Zalo</a>
    <a href={tel} aria-label={c.ui.call}
      class="grid size-14 place-items-center rounded-full bg-rose-500 text-white no-underline shadow-lg shadow-black/20 transition hover:scale-105"><Icon name="phone" size={26} weight="fill" /></a>
  </div>

  <!-- Phone tab bar -->
  <nav class="no-print fixed inset-x-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-50 lg:hidden" aria-label="Tabs" style="view-transition-name: tabbar">
    <ul class="grid grid-cols-5 rounded-[1.75rem] border border-hair/70 bg-raised/95 p-1.5 shadow-[var(--shadow)]">
      {tabs.map(({ k, icon }) => (
        <li>
          <a href={pageHref(lang, k)} aria-current={k === active ? "page" : undefined}
            class:list={["relative flex flex-col items-center gap-0.5 rounded-[1.4rem] py-2 text-[0.66rem] font-semibold no-underline", k === active ? "text-accent-ink" : "text-ink-3"]}>
            {k === active && <span class="absolute inset-0 -z-10 rounded-[1.4rem] bg-tint" style="view-transition-name: nav-pill"></span>}
            <Icon name={icon} size={24} weight={k === active ? "fill" : "regular"} />
            <span class="whitespace-nowrap">{c.ui.tabs[k as keyof typeof c.ui.tabs]}</span>
          </a>
        </li>
      ))}
      <li>
        <button type="button" data-open-sheet aria-haspopup="dialog"
          class:list={["relative flex w-full flex-col items-center gap-0.5 rounded-[1.4rem] py-2 text-[0.66rem] font-semibold", moreActive ? "text-accent-ink" : "text-ink-3"]}>
          {moreActive && <span class="absolute inset-0 -z-10 rounded-[1.4rem] bg-tint" style="view-transition-name: nav-pill"></span>}
          <Icon name="more" size={24} weight={moreActive ? "fill" : "regular"} />
          <span>{c.ui.tabs.more}</span>
        </button>
      </li>
    </ul>
  </nav>

  <dialog class="sheet lg:hidden" id="sheet" aria-label={lang === "vi" ? "Thêm" : "More"}>
    <div class="mx-auto mt-3 h-1.5 w-12 rounded-full bg-hair" aria-hidden="true"></div>
    <div class="grid gap-2 p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]">
      {morePages.map((k, i) => (
        <a href={pageHref(lang, k)} data-close-sheet style={`--d:${i}`} aria-current={k === active ? "page" : undefined}
          class:list={["enter flex items-center gap-4 rounded-2xl px-4 py-3.5 text-lg font-semibold no-underline", k === active ? "bg-tint text-accent-ink" : "text-ink"]}>
          <span class="grid size-11 place-items-center rounded-full bg-tint text-accent-ink"><Icon name={moreIcons[k]} size={22} /></span>{label(k)}
        </a>
      ))}
      <div class="mt-3 grid grid-cols-2 gap-3">
        <a href={tel} class="btn btn-urgent"><Icon name="phone" size={20} weight="fill" />{c.ui.call}</a>
        <a href={contact.zaloGroup} target="_blank" rel="noopener" class="btn bg-zalo text-white">{c.ui.zalo}</a>
      </div>
    </div>
  </dialog>

  <script>
    // Runs once; listeners survive client-side navigation.
    document.addEventListener("pointermove", (e) => {
      const el = (e.target as Element | null)?.closest?.(".glow") as HTMLElement | null;
      if (!el) return;
      const r = el.getBoundingClientRect();
      el.style.setProperty("--mx", `${e.clientX - r.left}px`);
      el.style.setProperty("--my", `${e.clientY - r.top}px`);
    }, { passive: true });

    document.addEventListener("astro:page-load", () => {
      const sheet = document.getElementById("sheet") as HTMLDialogElement | null;
      document.querySelector("[data-open-sheet]")?.addEventListener("click", () => sheet?.showModal());
      sheet?.addEventListener("click", (e) => { if (e.target === sheet) sheet.close(); });
      sheet?.querySelectorAll("[data-close-sheet]").forEach((a) => a.addEventListener("click", () => sheet.close()));
    });
  </script>
</body>
</html>
