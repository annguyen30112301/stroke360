---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Words from "../components/Words.astro";
import Counter from "../components/Counter.astro";
import { getContent, pageHref } from "../lib/i18n";
import type { Lang } from "../content/types";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const t = c.tacDong;
---
<Base lang={lang} route="tacDong" title={c.meta.tacDong.title} description={c.meta.tacDong.description}>
  <!-- Manifesto hero -->
  <section class="bg-deep pb-24 pt-36 text-white sm:pb-32 sm:pt-44">
    <div class="shell">
      <span class="enter rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-teal-100">{t.eyebrow}</span>
      <h1 class="mt-8 max-w-[22ch] text-[clamp(2.1rem,1.2rem+3.4vw,4.4rem)] font-extrabold leading-[1.06] tracking-tight !text-white"><Words text={t.title} /></h1>
    </div>
  </section>

  <!-- Indicators -->
  <section class="py-24 sm:py-32">
    <div class="shell">
      <h2 class="t-title" data-reveal>{t.statsTitle}</h2>
      <p class="t-sub mt-4" data-reveal>{t.statsSub}</p>
      <dl class="mt-14 grid gap-px overflow-hidden rounded-3xl bg-hair sm:grid-cols-2 lg:grid-cols-3">
        {c.impact.map((m, i) => (
          <div class:list={["p-8 sm:p-10", i === 0 ? "bg-accent text-on-accent" : "bg-raised"]} data-reveal>
            <dt class="text-[clamp(2.6rem,2rem+2vw,3.8rem)] font-extrabold leading-none tracking-tight"><Counter value={m.value} lang={lang} decimals={m.decimals} prefix={m.prefix} suffix={m.suffix} /></dt>
            <dd class:list={["mt-4 max-w-[26ch]", i === 0 ? "opacity-85" : "text-ink-2"]}>{m.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Who benefits: icon list -->
  <section class="bg-tint/60 py-24 sm:py-32">
    <div class="shell grid gap-12 lg:grid-cols-[0.8fr_2fr]">
      <h2 class="t-title lg:sticky lg:top-28 lg:self-start" data-reveal>{t.whoTitle}</h2>
      <ul class="grid gap-x-10 gap-y-12 sm:grid-cols-2">
        {t.who.map((w) => (
          <li data-reveal>
            <Icon name={w.icon} size={40} class="text-accent" />
            <h3 class="mt-4 text-xl">{w.title}</h3>
            <p class="mt-2 text-ink-2">{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Hours: two bars, sized by actual hours -->
  <section class="py-24 sm:py-32">
    <div class="shell max-w-5xl">
      <h2 class="t-title" data-reveal>{t.hoursTitle}</h2>
      <p class="t-sub mt-4" data-reveal>{t.hoursSub}</p>
      <div class="mt-14 grid gap-10">
        <div data-reveal>
          <div class="flex flex-wrap items-baseline justify-between gap-2"><b class="text-lg">{t.hoursUs[0]}</b><span class="text-ink-3">{t.hoursUs[1]}</span></div>
          <div data-grow class="mt-3 flex h-14 w-[38%] items-center justify-end rounded-full bg-accent pr-5 text-lg font-extrabold text-on-accent">228h</div>
        </div>
        <div data-reveal>
          <div class="flex flex-wrap items-baseline justify-between gap-2"><b class="text-lg">{t.hoursThem[0]}</b><span class="text-ink-3">{t.hoursThem[1]}</span></div>
          <div data-grow class="mt-3 flex h-14 w-full items-center justify-end rounded-full bg-ink-3/40 pr-5 text-lg font-extrabold text-ink">~600h</div>
        </div>
      </div>
      <p class="mt-10 text-ink-2">{t.hoursNote} <a href={pageHref(lang, "tuyenDung")} class="font-semibold">{t.hoursLink} →</a></p>
    </div>
  </section>

  <!-- Quarterly report: indicator cards, not a ruled table -->
  <section class="border-t border-hair py-24 sm:py-32">
    <div class="shell">
      <h2 class="t-title" data-reveal>{t.reportTitle}</h2>
      <p class="t-note mt-3">{t.reportNote}</p>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {t.report.map(([k, v]) => (
          <li class="panel-line p-7" data-reveal>
            <p class="text-sm text-ink-3">{t.reportHead[1]}</p>
            <p class="mt-1 text-3xl font-extrabold tracking-tight tabular-nums text-accent-ink">{v}</p>
            <p class="mt-3 font-medium">{k}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
