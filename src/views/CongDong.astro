---
import QRCode from "qrcode";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Words from "../components/Words.astro";
import FatigueCheck from "../islands/FatigueCheck.tsx";
import AskForm from "../islands/AskForm.tsx";
import { getContent, pageHref, lessonHref } from "../lib/i18n";
import { contact } from "../content/shared";
import type { Lang } from "../content/types";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const t = c.congDong;
const z = contact.zaloGroup;
const qr = await QRCode.toString(z, { type: "svg", margin: 1, color: { dark: "#063f3e", light: "#ffffff" } });
const groupIcons = ["hospital", "bed", "plant"];
const initial = (who: string) => who.replace(/^(Chị|Anh|Cô|Bà|Mrs\.) /, "").charAt(0);
---
<Base lang={lang} route="congDong" title={c.meta.congDong.title} description={c.meta.congDong.description}>
  <section class="relative overflow-hidden pt-28 sm:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 top-0 -z-10 size-[40rem] rounded-full bg-teal-300/20 blur-3xl dark:bg-teal-500/10"></div>
    <div class="shell grid items-center gap-12 pb-20 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <span class="chip enter">{t.eyebrow}</span>
        <h1 class="t-display mt-5 max-w-[16ch]"><Words text={t.title} /></h1>
        <p class="t-sub enter mt-6" style="--d:3">{t.lead}</p>
        <a class="btn enter mt-9 bg-zalo text-white hover:brightness-110" style="--d:4" href={z} target="_blank" rel="noopener"><Icon name="chats" size={22} />{t.join}</a>
      </div>
      <figure class="panel enter mx-auto flex w-full max-w-sm flex-col items-center p-8 text-center" style="--d:2">
        <div class="w-56 overflow-hidden rounded-2xl bg-white p-3" role="img" aria-label={t.qrAlt} set:html={qr} />
        <figcaption class="mt-5 font-semibold">{t.qrTitle}<span class="t-note mt-1 block font-normal">{t.qrNote}</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- Stories: horizontal snap rail -->
  <section class="overflow-hidden bg-deep py-24 text-white sm:py-32">
    <div class="shell flex items-end justify-between gap-6">
      <h2 class="t-title !text-white" data-reveal>{t.storiesTitle}</h2>
      <p class="text-sm text-teal-50/50">{c.ui.illustrative}</p>
    </div>
    <ul class="gap-5 mt-12 flex snap-x snap-mandatory scroll-px-4 overflow-x-auto px-4 pb-4 [scrollbar-width:none] sm:scroll-px-6 sm:px-6 lg:scroll-px-8 lg:px-[max(2rem,calc((100vw-80rem)/2+2rem))]">
      {c.stories.map((s) => (
        <li class="flex w-[85%] shrink-0 snap-start flex-col rounded-3xl bg-white/[0.06] p-8 ring-1 ring-white/10 sm:w-[26rem]">
          <span class="self-start rounded-full bg-white/10 px-3 py-1 text-sm font-semibold text-teal-100">{s.stage}</span>
          <blockquote class="mt-6 text-xl font-semibold leading-snug text-white">“{s.quote}”</blockquote>
          <p class="mt-4 flex-1 text-teal-50/70">{s.body}</p>
          <div class="mt-8 flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-full bg-teal-400 font-bold text-teal-950">{initial(s.who)}</span>
            <span><b class="block text-sm !text-white">{s.who}</b><span class="text-sm text-teal-50/60">{s.role}</span></span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Groups -->
  <section class="py-24 sm:py-32">
    <div class="shell">
      <h2 class="t-title" data-reveal>{t.groupsTitle}</h2>
      <ul class="mt-12 grid gap-4 lg:grid-cols-[1.4fr_1fr_1fr]">
        {c.groups.map((g, i) => (
          <li data-reveal>
            <a href={z} target="_blank" rel="noopener" class:list={["glow lift group flex h-full flex-col rounded-3xl p-8 no-underline", i === 0 ? "bg-accent text-on-accent" : "bg-raised shadow-[var(--shadow)]"]}>
              <Icon name={groupIcons[i]} size={36} class={i === 0 ? "" : "text-accent"} />
              <h3 class:list={["mt-8 text-2xl", i === 0 && "!text-on-accent"]}>{g.name}</h3>
              <p class:list={["mt-2 flex-1", i === 0 ? "opacity-85" : "text-ink-2"]}>{g.desc}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 font-semibold">{t.groupJoin}<Icon name="external" size={18} weight="bold" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Ask a nurse -->
  <section id="hoi" class="scroll-mt-24 bg-tint/60 py-24 sm:py-32">
    <div class="shell grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h2 class="t-title" data-reveal>{t.askTitle}</h2>
        <p class="t-sub mt-4" data-reveal>{t.askLead}</p>
        <AskForm client:visible t={t.ask} />
      </div>
      <div>
        {c.faqs.map(([q, a]) => (
          <details class="qa">
            <summary>{q}<span class="plus" aria-hidden="true"><Icon name="x" size={16} weight="bold" class="rotate-45" /></span></summary>
            <p class="max-w-[60ch] pb-6 text-ink-2">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Events + caregiver check -->
  <section class="py-24 sm:py-32">
    <div class="shell grid gap-16 lg:grid-cols-2">
      <div>
        <h2 class="t-title" data-reveal>{t.eventsTitle}</h2>
        <ol class="mt-10 grid">
          {c.events.map((e) => (
            <li class="grid grid-cols-[7.5rem_1fr] gap-5 border-t border-hair py-6 sm:grid-cols-[9rem_1fr]" data-reveal>
              <span class:list={["text-sm font-bold", e.hot ? "text-urgent" : "text-accent-ink"]}>{e.date}</span>
              <div>
                <h3 class="text-lg">{e.title}</h3>
                <p class="mt-1 flex items-center gap-1 text-sm text-ink-3"><Icon name="pin" size={15} />{e.where}</p>
                {e.hot && <a class="btn btn-urgent mt-4 !min-h-10 !px-4 !text-sm" href={lessonHref(lang, "B3")}><Icon name="siren" size={16} />{t.eventCta}</a>}
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2 class="t-title" data-reveal>{t.careTitle}</h2>
        <div class="mt-10"><FatigueCheck client:visible t={t.fatigue} c4={lessonHref(lang, "C4")} service={pageHref(lang, "dichVu")} /></div>
      </div>
    </div>
  </section>

  <section class="border-t border-hair py-24">
    <div class="shell grid gap-12 md:grid-cols-2">
      <div data-reveal>
        <Icon name="handHeart" size={40} class="text-accent" />
        <h3 class="mt-5 text-2xl">{t.volunteer.title}</h3>
        <p class="mt-3 text-ink-2">{t.volunteer.text}</p>
        <a class="btn btn-quiet mt-6" href={pageHref(lang, "lienHe", "?topic=dong-hanh")}>{t.volunteer.cta}</a>
      </div>
      <div data-reveal>
        <Icon name="shield" size={40} class="text-accent" />
        <h3 class="mt-5 text-2xl">{t.rules.title}</h3>
        <ul class="mt-4 grid gap-3">
          {t.rules.items.map((r) => <li class="flex gap-3 text-ink-2"><Icon name="check" size={20} weight="bold" class="mt-1 shrink-0 text-accent" />{r}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
