---
import QRCode from "qrcode";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import FatigueCheck from "../islands/FatigueCheck.tsx";
import AskForm from "../islands/AskForm.tsx";
import { getContent, pageHref, lessonHref } from "../lib/i18n";
import { contact } from "../content/shared";
import type { Lang } from "../content/types";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const t = c.congDong;
const z = contact.zaloGroup;
const qr = await QRCode.toString(z, { type: "svg", margin: 1, color: { dark: "#0b3f3f", light: "#ffffff" } });
const groupIcons = ["hospital", "bed", "plant"];
---
<Base lang={lang} page="congDong" path="cong-dong.html" title={c.meta.congDong.title} description={c.meta.congDong.description}>
  <PageHero eyebrow={t.eyebrow} title={t.title} lead={t.lead}>
    <a class="btn mt-8 bg-zalo text-white hover:brightness-110" href={z} target="_blank" rel="noopener"><Icon name="chats" size={22} />{t.join}</a>
    <div slot="aside" class="card mx-auto max-w-sm text-center">
      <h2 class="text-xl">{t.qrTitle}</h2>
      <div class="mx-auto mt-4 w-56 overflow-hidden rounded-2xl border border-line bg-white p-3" role="img" aria-label={t.qrAlt} set:html={qr} />
      <p class="note mt-3">{t.qrNote}</p>
    </div>
  </PageHero>

  <section class="section pt-0">
    <div class="wrap">
      <SectionHead title={t.storiesTitle} sub={c.ui.illustrative} />
      <div class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 [scrollbar-width:thin] md:mx-0 md:grid md:grid-cols-2 md:overflow-visible md:px-0 lg:grid-cols-3">
        {c.stories.map((s, i) => (
          <figure class:list={["card flex w-[85%] shrink-0 snap-center flex-col md:w-auto", i === 0 && "lg:col-span-2 lg:row-span-1"]} data-reveal>
            <span class="tag self-start">{s.stage}</span>
            <Icon name="quote" size={32} weight="fill" class="mt-4 text-teal-200 dark:text-teal-800" />
            <blockquote class:list={["mt-1 font-semibold leading-snug text-brand", i === 0 ? "text-lg lg:text-2xl" : "text-lg"]}>“{s.quote}”</blockquote>
            <p class="mt-3 flex-1 text-[0.92rem] text-muted">{s.body}</p>
            <figcaption class="mt-5 flex items-center gap-3 border-t border-line pt-4">
              <span class="grid size-10 place-items-center rounded-full bg-gradient-to-br from-teal-500 to-rose-500 font-bold text-white">{s.who.replace(/^(Chị|Anh|Cô|Bà|Mrs\.) /, "").charAt(0)}</span>
              <span><b class="block text-sm">{s.who}</b><span class="text-sm text-muted">{s.role}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-brand-soft/50">
    <div class="wrap">
      <SectionHead title={t.groupsTitle} />
      <div class="grid gap-4 md:grid-cols-3">
        {c.groups.map((g, i) => (
          <a href={z} target="_blank" rel="noopener" class="card card-link group" data-reveal>
            <span class="icon-tile"><Icon name={groupIcons[i]} size={28} /></span>
            <h3 class="mt-4 text-xl">{g.name}</h3>
            <p class="mt-1 text-[0.95rem] text-muted">{g.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 font-semibold text-brand">{t.groupJoin}<Icon name="external" size={18} weight="bold" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="hoi" class="section">
    <div class="wrap max-w-3xl">
      <SectionHead title={t.askTitle} sub={t.askLead} />
      <div class="grid gap-3">
        {c.faqs.map(([q, a]) => (
          <details class="faq">
            <summary>{q}<span class="chev" aria-hidden="true"><Icon name="x" size={16} weight="bold" class="rotate-45" /></span></summary>
            <p class="px-5 pb-5 text-muted">{a}</p>
          </details>
        ))}
      </div>
      <AskForm client:visible t={t.ask} />
    </div>
  </section>

  <section class="section bg-sunken">
    <div class="wrap grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="h-section" data-reveal>{t.eventsTitle}</h2>
        <ol class="mt-8 grid gap-3">
          {c.events.map((e) => (
            <li class:list={["card-flat flex gap-4 !p-5", e.hot && "!border-2 !border-rose-500"]} data-reveal>
              <span class:list={["grid size-12 shrink-0 place-items-center rounded-2xl", e.hot ? "bg-rose-500 text-white" : "bg-brand-soft text-brand"]}><Icon name={e.hot ? "siren" : "calendar"} size={24} /></span>
              <div>
                <span class:list={["tag", e.hot && "tag-alert"]}>{e.date}</span>
                <h3 class="mt-1.5 text-lg">{e.title}</h3>
                <p class="flex items-center gap-1 text-sm text-muted"><Icon name="pin" size={15} />{e.where}</p>
                {e.hot && <a class="btn btn-alert mt-3 !min-h-10 !px-4 !text-sm" href={lessonHref(lang, "B3")}>{t.eventCta}</a>}
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2 class="h-section" data-reveal>{t.careTitle}</h2>
        <div class="mt-8"><FatigueCheck client:visible t={t.fatigue} c4={lessonHref(lang, "C4")} service={pageHref(lang, "dichVu")} /></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid gap-5 md:grid-cols-2">
      <div class="card" data-reveal>
        <span class="icon-tile alert"><Icon name="handHeart" size={28} /></span>
        <h3 class="mt-4 text-xl">{t.volunteer.title}</h3>
        <p class="mt-2 text-muted">{t.volunteer.text}</p>
        <a class="btn btn-ghost mt-5" href={pageHref(lang, "lienHe", "?topic=dong-hanh")}>{t.volunteer.cta}</a>
      </div>
      <div class="card" data-reveal>
        <span class="icon-tile"><Icon name="shield" size={28} /></span>
        <h3 class="mt-4 text-xl">{t.rules.title}</h3>
        <ul class="mt-3 grid gap-2.5">
          {t.rules.items.map((r) => <li class="flex gap-2.5 text-[0.95rem] text-muted"><Icon name="check" size={20} weight="bold" class="mt-0.5 shrink-0 text-brand" />{r}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
