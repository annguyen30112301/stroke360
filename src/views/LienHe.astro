---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Words from "../components/Words.astro";
import ContactForm from "../islands/ContactForm.tsx";
import { getContent, lessonHref } from "../lib/i18n";
import { contact } from "../content/shared";
import type { Lang } from "../content/types";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const t = c.lienHe;
const options: [string, string][] = [
  ...c.services.map((s): [string, string] => [s.code, `${s.code} · ${s.name}`]),
  ...c.counseling.map((s): [string, string] => [s.id, `${t.form.counselingPrefix} · ${s.name}`]),
  ...t.form.extraTopics
];
const valueIcons = ["shield", "eye", "handHeart", "scope"];
const tel = "tel:" + contact.hotline.replace(/\s/g, "");
---
<Base lang={lang} route="lienHe" title={c.meta.lienHe.title} description={c.meta.lienHe.description}>
  <section class="relative overflow-hidden pb-24 pt-28 sm:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -left-40 -top-40 -z-10 size-[40rem] rounded-full bg-teal-300/20 blur-3xl dark:bg-teal-500/10"></div>
    <div class="shell grid gap-14 lg:grid-cols-[1fr_1.05fr] lg:gap-20">
      <div>
        <span class="chip enter"><Icon name="clock" size={16} />{t.eyebrow}</span>
        <h1 class="t-display mt-5"><Words text={t.title} /></h1>
        <div class="enter mt-8 grid gap-3" style="--d:3">
          <a href={tel} class="glow lift flex items-center gap-4 rounded-3xl bg-rose-600 p-5 text-white no-underline">
            <span class="grid size-12 place-items-center rounded-full bg-white/15"><Icon name="phone" size={24} weight="fill" /></span>
            <span><span class="block text-sm opacity-80">{c.ui.call}</span><b class="text-xl !text-white">{contact.hotline}</b></span>
          </a>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href={contact.zaloGroup} target="_blank" rel="noopener" class="lift flex items-center gap-3 rounded-3xl bg-zalo p-5 font-semibold text-white no-underline"><Icon name="chats" size={24} />{c.ui.zalo}</a>
            <a href={`mailto:${contact.email}`} class="lift flex items-center gap-3 rounded-3xl bg-raised p-5 font-semibold text-ink no-underline shadow-[var(--shadow)]"><Icon name="mail" size={24} class="text-accent" /><span class="truncate">{contact.email}</span></a>
          </div>
        </div>
        <div class="enter mt-12 grid gap-4 border-t border-hair pt-8" style="--d:4">
          <p class="text-ink-2" set:html={t.vision} />
          <p class="text-ink-2" set:html={t.mission} />
          <ul class="mt-2 flex flex-wrap gap-2">
            {t.values.map((v, i) => <li class="chip"><Icon name={valueIcons[i]} size={16} />{v}</li>)}
          </ul>
        </div>
      </div>
      <div class="enter lg:sticky lg:top-28 lg:self-start" style="--d:2">
        <ContactForm client:load t={t.form} options={options} hotline={contact.hotline} lessonHref={lessonHref(lang, "A1")} />
      </div>
    </div>
  </section>
</Base>
