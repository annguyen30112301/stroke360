---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageIntro from "../components/PageIntro.astro";
import { getContent, pageHref } from "../lib/i18n";
import type { Lang } from "../content/types";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const t = c.benhVien;
const pilotIcons = ["search", "pulse", "target"];
---
<Base lang={lang} route="benhVien" title={c.meta.benhVien.title} description={c.meta.benhVien.description}>
  <PageIntro chip={t.eyebrow} title={t.title} lead={t.lead}
    photo={{ name: "hero-care", alt: lang === "vi" ? "Chăm sóc viên STROKE360 tại khoa" : "A STROKE360 caregiver on the ward", icon: "hospital" }}>
    <a class="btn btn-accent mt-8" href={pageHref(lang, "lienHe", "?topic=benh-vien")}>{t.cta}<Icon name="arrow" size={18} weight="bold" /></a>
  </PageIntro>

  <section class="py-24 sm:py-32">
    <div class="shell grid gap-px overflow-hidden rounded-3xl bg-hair md:grid-cols-2">
      {[[t.getTitle, t.get, "hospital"], [t.promiseTitle, t.promise, "shield"]].map(([title, items, icon], i) => (
        <div class:list={["p-8 sm:p-12", i ? "bg-raised" : "bg-tint"]} data-reveal>
          <Icon name={icon as string} size={40} class="text-accent" />
          <h2 class="mt-6 text-3xl">{title}</h2>
          <ul class="mt-8 grid gap-5">
            {(items as string[]).map((x) => <li class="flex gap-3 text-[1.05rem]"><Icon name="check" size={22} weight="bold" class="mt-0.5 shrink-0 text-accent" /><span>{x}</span></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Pilot: three steps on a growing line -->
  <section class="bg-deep py-24 text-white sm:py-32">
    <div class="shell">
      <h2 class="t-title !text-white" data-reveal>{t.pilotTitle}</h2>
      <div class="relative mt-16">
        <span aria-hidden="true" data-grow class="absolute left-8 right-8 top-8 hidden h-px bg-teal-300/60 md:block"></span>
        <ol class="grid gap-12 md:grid-cols-3">
          {t.pilot.map(([m, title, text], i) => (
            <li class="relative" data-reveal>
              <span class="relative grid size-16 place-items-center rounded-full bg-teal-400 text-teal-950"><Icon name={pilotIcons[i]} size={28} /></span>
              <p class="mt-6 text-sm font-semibold text-teal-300">{m}</p>
              <h3 class="mt-1 text-2xl !text-white">{title}</h3>
              <p class="mt-3 text-teal-50/75">{text}</p>
            </li>
          ))}
        </ol>
      </div>
      <a class="btn btn-light mt-16" href={pageHref(lang, "lienHe", "?topic=benh-vien")}>{t.cta}</a>
    </div>
  </section>
</Base>
