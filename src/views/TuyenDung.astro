---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageIntro from "../components/PageIntro.astro";
import { getContent, pageHref } from "../lib/i18n";
import type { Lang } from "../content/types";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const t = c.tuyenDung;
const trainIcons = ["bed", "heart", "pulse", "siren", "notebook"];
const apply = pageHref(lang, "lienHe", "?topic=tuyen-dung");
---
<Base lang={lang} route="tuyenDung" title={c.meta.tuyenDung.title} description={c.meta.tuyenDung.description}>
  <PageIntro chip={t.eyebrow} title={t.title} lead={t.lead}>
    <a class="btn btn-accent mt-8" href={apply}>{t.apply}<Icon name="arrow" size={18} weight="bold" /></a>
  </PageIntro>

  <section class="pb-24">
    <dl class="shell grid gap-y-10 sm:grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-hair">
      {t.stats.map(([v, l]) => (
        <div class="lg:px-8 lg:first:pl-0" data-reveal>
          <dt class="text-[clamp(2.04rem,1.53rem+1.7vw,3.06rem)] font-extrabold tracking-tight text-accent-ink">{v}</dt>
          <dd class="mt-2 text-ink-2">{l}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="bg-tint/60 py-24 sm:py-32">
    <div class="shell grid gap-16 lg:grid-cols-2">
      <div>
        <h2 class="t-title" data-reveal>{t.getTitle}</h2>
        <ul class="mt-10 grid gap-6">
          {t.get.map((x) => <li class="flex gap-4 text-lg" data-reveal><span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full bg-accent text-on-accent"><Icon name="check" size={16} weight="bold" /></span>{x}</li>)}
        </ul>
      </div>
      <div class="panel p-8 sm:p-10" data-reveal>
        <h3 class="text-2xl">{t.trainingTitle}</h3>
        <ol class="mt-8 grid gap-3">
          {t.training.map((x, i) => (
            <li class="flex items-center gap-4 rounded-2xl bg-canvas p-4">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-raised text-accent"><Icon name={trainIcons[i]} size={22} /></span><span>{x}</span>
            </li>
          ))}
        </ol>
        <a class="btn btn-accent mt-8" href={apply}>{t.apply}</a>
      </div>
    </div>
  </section>
</Base>
