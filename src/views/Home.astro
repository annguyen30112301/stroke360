---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Photo from "../components/Photo.astro";
import Counter from "../components/Counter.astro";
import ComparePanel from "../islands/ComparePanel.tsx";
import HeroDay from "../islands/HeroDay.tsx";
import ScrollWords from "../islands/ScrollWords.tsx";
import { getContent, pageHref, lessonHref, type PageKey } from "../lib/i18n";
import type { Lang } from "../content/types";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const h = c.home;
const headline = `${h.h1[0]} ${h.h1[1]} ${h.h1[2]}`;
const marquee = [...c.promises.map(([a]) => a), ...h.values.items.map((v) => v.title)];
const lead = h.lead.replace(/<\/?b>/g, "");
const stories = h.story.steps;
---
<Base lang={lang} route="home" title={c.meta.home.title} description={c.meta.home.description}>

  <!-- Hero: one scroll = one day shift -->
  <HeroDay client:load day={headline} brand={h.h1[1]} night={h.h1[3]} lead={lead}
    cta={{ label: h.cta2, href: pageHref(lang, "dichVu", "#chon-goi") }} cta2={{ label: h.cta1, href: "#vi-sao" }}
    diary={c.diary} phone={{ top: c.nhatKy.phoneTop, patient: c.nhatKy.patient, carer: c.nhatKy.carer }} notify={h.diary.head} />

  <!-- Promise marquee (the one marquee on this page) -->
  <section aria-label={c.dichVu.promisesTitle} class="marquee overflow-hidden border-y border-hair bg-raised py-5">
    <div class="marquee-track flex w-max gap-12 pr-12">
      {[...marquee, ...marquee].map((t, i) => (
        <span class="flex items-center gap-3 whitespace-nowrap text-lg font-semibold text-ink-2" aria-hidden={i >= marquee.length ? "true" : undefined}>
          <Icon name="seal" size={22} class="text-accent" />{t}
        </span>
      ))}
    </div>
  </section>

  <!-- Story: pinned photo + stacking day cards -->
  <section id="vi-sao" class="py-24 sm:py-32">
    <div class="shell grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <span class="chip">{h.story.eyebrow}</span>
        <h2 class="t-title mt-5">{h.story.title}</h2>
        <Photo name="family-evening" alt={lang === "vi" ? "Hai người con bên mẹ, dải lụa teal và đỏ của STROKE360 ôm lấy cả gia đình" : "Two adult children beside their mother, wrapped by the STROKE360 teal and red ribbon"}
          class="mt-8 hidden aspect-[3/2] w-full rounded-3xl lg:block [&_img]:object-[70%_50%]" icon="family" />
        <p class="t-note mt-4">{h.story.note}</p>
      </div>
      <ol class="grid gap-5">
        {stories.map(([time, text], i) => (
          <li class="stack-card panel p-8 sm:p-10 lg:sticky" style={`--top:${7 + i * 1.25}rem`}>
            <p class="text-sm font-bold text-accent-ink">{time}</p>
            <p class="mt-3 text-xl leading-relaxed text-ink">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="bg-deep py-24 text-center text-white sm:py-36">
    <div class="shell max-w-5xl">
      <Icon name="quote" size={48} weight="fill" class="mx-auto text-teal-300" />
      <ScrollWords client:visible text={h.story.quote} className="mt-6 text-[clamp(1.53rem,0.94rem+2.38vw,3.23rem)] font-bold leading-[1.15] tracking-tight" />
      <p class="mx-auto mt-8 max-w-2xl text-lg text-teal-50/75" data-reveal>{h.story.after}</p>
    </div>
  </section>

  <!-- Facts: oversized numbers, no cards -->
  <section class="py-24 sm:py-32">
    <div class="shell">
      <h2 class="t-title max-w-3xl" data-reveal>{h.facts.title}</h2>
      <dl class="mt-14 grid gap-y-12 sm:grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-hair">
        {h.facts.items.map((f) => (
          <div class="lg:px-8 lg:first:pl-0" data-reveal>
            <dt class:list={["font-extrabold tracking-tight", f.word ? "text-[clamp(1.87rem,1.36rem+1.7vw,2.72rem)] text-accent-ink" : "whitespace-nowrap text-[clamp(2.04rem,1.36rem+1.87vw,2.98rem)] text-ink"]}>
              {f.word ?? <Counter value={f.v!} lang={lang} prefix={f.p} suffix={f.s} />}
            </dt>
            <dd class="mt-3 max-w-[28ch] text-ink-2">{f.text}</dd>
          </div>
        ))}
      </dl>
      <p class="t-note mt-12">{h.facts.source}</p>
    </div>
  </section>

  <!-- Compare: segmented switch -->
  <section class="bg-tint/60 py-24 sm:py-32">
    <div class="shell">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <h2 class="t-title">{h.compare.title}</h2>
        <p class="t-sub mx-auto mt-4">{h.compare.sub}</p>
      </div>
      <div class="mt-10"><ComparePanel client:visible left={h.compare.left} right={h.compare.right} rows={h.compare.rows} /></div>
    </div>
  </section>

  <!-- Offer: bento -->
  <section class="py-24 sm:py-32">
    <div class="shell">
      <h2 class="t-title max-w-3xl" data-reveal>{h.pillars.title}</h2>
      <p class="t-sub mt-4" data-reveal>{h.pillars.sub}</p>
      <div class="mt-12 grid gap-4 lg:grid-cols-3 lg:grid-rows-2">
        {h.pillars.items.map((p, i) => (
          <a href={pageHref(lang, p.page as PageKey)} data-reveal
            class:list={["glow lift group relative flex flex-col overflow-hidden rounded-3xl no-underline",
              i === 0 && "min-h-[28rem] bg-deep text-white lg:col-span-2 lg:row-span-2",
              i === 1 && "bg-raised p-8 shadow-[var(--shadow)]",
              i === 2 && "bg-tint p-8"]}>
            {i === 0 && (
              <Photo name="bedside-learn" alt={lang === "vi" ? "Dải lụa trái tim STROKE360 và hình ảnh não bộ: hiểu về đột quỵ" : "The STROKE360 heart ribbon and a brain illustration: understanding stroke"}
                class="absolute inset-0 size-full opacity-70 [&_img]:object-[70%_50%] transition-transform duration-700 group-hover:scale-105" icon="book" />
            )}
            <div class:list={["relative mt-auto", i === 0 && "bg-gradient-to-t from-deep via-deep/80 to-transparent p-8 pt-24 sm:p-10 sm:pt-32"]}>
              <span class:list={["grid size-12 place-items-center rounded-full", i === 0 ? "bg-white/15 text-white" : "bg-tint text-accent-ink", i === 2 && "!bg-raised"]}><Icon name={p.icon} size={26} /></span>
              <h3 class:list={["mt-5", i === 0 ? "text-[clamp(1.36rem,1.02rem+1.19vw,2.04rem)] !text-white" : "text-2xl"]}>{p.title}</h3>
              <p class:list={["mt-2 max-w-[48ch]", i === 0 ? "text-teal-50/80 text-lg" : "text-ink-2"]}>{p.text}</p>
              <span class:list={["mt-6 inline-flex items-center gap-2 font-semibold", i === 0 ? "text-teal-200" : "text-accent-ink"]}>{p.cta}<Icon name="arrow" size={18} weight="bold" class="transition-transform group-hover:translate-x-1" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Values: open grid, no cards -->
  <section class="border-t border-hair py-24 sm:py-32">
    <div class="shell grid gap-14 lg:grid-cols-[0.9fr_2fr]">
      <h2 class="t-title lg:sticky lg:top-28 lg:self-start" data-reveal>{h.values.title}</h2>
      <div class="grid gap-x-12 gap-y-14 sm:grid-cols-2">
        {h.values.items.map((v) => (
          <div data-reveal>
            <Icon name={v.icon} size={40} class="text-accent" />
            <h3 class="mt-5 text-xl">{v.title}</h3>
            <p class="mt-2 text-ink-2">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Roadmap carousel (auto-advances every 5s, buttons, swipe, dots) + team -->
  <section class="overflow-hidden bg-raised py-24 sm:py-32">
    <div class="shell flex flex-wrap items-end justify-between gap-6">
      <div>
        <h2 class="t-title" data-reveal>{h.road.title}</h2>
        <p class="t-sub mt-4" data-reveal>{h.road.sub}</p>
      </div>
      <div class="flex gap-2">
        <button type="button" data-road-prev aria-label={h.road.prev} class="grid size-12 place-items-center rounded-full bg-tint text-accent-ink transition hover:bg-teal-100 active:scale-95 disabled:opacity-40"><Icon name="arrow" size={20} weight="bold" class="rotate-180" /></button>
        <button type="button" data-road-next aria-label={h.road.next} class="grid size-12 place-items-center rounded-full bg-accent text-on-accent transition active:scale-95 disabled:opacity-40"><Icon name="arrow" size={20} weight="bold" /></button>
      </div>
    </div>
    <div data-road class="mt-12" role="region" aria-roledescription="carousel" aria-label={h.road.title}>
      <ol data-road-track class="relative flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-4 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden scroll-px-4 sm:scroll-px-6 sm:px-6 lg:scroll-px-[max(2rem,calc((100vw-80rem)/2+2rem))] lg:px-[max(2rem,calc((100vw-80rem)/2+2rem))]">
        {h.road.items.map(([y, t, d], i) => (
          <li aria-roledescription="slide" aria-label={`${i + 1} / ${h.road.items.length}`}
            class:list={["w-[85%] shrink-0 snap-start rounded-3xl p-8 sm:w-[24rem]", i === 3 ? "bg-deep text-white" : "bg-canvas"]}>
            <p class:list={["text-sm font-bold", i === 3 ? "text-teal-300" : "text-accent-ink"]}>{y}</p>
            <h3 class:list={["mt-2 text-3xl", i === 3 && "!text-white"]}>{t}</h3>
            <p class:list={["mt-4", i === 3 ? "text-teal-50/75" : "text-ink-2"]}>{d}</p>
          </li>
        ))}
        <li aria-hidden="true" class="w-px shrink-0"></li>
      </ol>
      <div class="shell mt-6 flex items-center gap-2">
        {h.road.items.map((_, i) => (
          <button type="button" data-road-dot={i} aria-label={`${h.road.goTo} ${i + 1}`}
            class="h-2.5 w-2.5 rounded-full bg-hair transition-all duration-300 aria-[current=true]:w-8 aria-[current=true]:bg-accent"></button>
        ))}
      </div>
    </div>
    <div class="shell mt-20">
      <h3 class="text-2xl" data-reveal>{h.team.title}</h3>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[...h.team.people, { initial: "+", name: h.team.advisor.name, role: h.team.advisor.role }].map((p) => (
          <li class="flex items-start gap-4" data-reveal>
            <span class="grid size-14 shrink-0 place-items-center rounded-full bg-tint text-xl font-extrabold text-accent-ink">
              {p.initial === "+" ? <Icon name="seal" size={26} /> : p.initial || <Icon name="sparkle" size={22} />}
            </span>
            <div><p class="font-semibold">{p.name}</p><p class="text-sm text-ink-3">{p.role}</p></div>
          </li>
        ))}
      </ul>
      <div class="glow mt-14 overflow-hidden rounded-3xl bg-deep p-8 text-white sm:p-12 lg:p-14" data-reveal>
        <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-14">
          <span class="grid size-20 shrink-0 place-items-center rounded-full bg-white/10 text-teal-300"><Icon name="handHeart" size={44} weight="fill" /></span>
          <div>
            <p class="text-sm font-bold uppercase tracking-wider text-teal-300">{h.team.noteTitle}</p>
            <p class="mt-4 max-w-[34ch] text-[clamp(1.4rem,1.05rem+1.4vw,2.3rem)] font-bold leading-snug tracking-tight text-white text-balance">{h.team.note}</p>
            <p class="mt-5 max-w-[60ch] text-lg text-teal-50/80">{h.team.noteThanks}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Paths: big link index + urgent BE-FAST -->
  <section class="py-24 sm:py-32">
    <div class="shell">
      <h2 class="t-title" data-reveal>{h.paths.title}</h2>
      <ul class="mt-10 border-t border-hair">
        {h.paths.items.map((p) => (
          <li class="border-b border-hair">
            <a href={pageHref(lang, p.page as PageKey, p.hash)} class="group grid grid-cols-[auto_1fr_auto] items-center gap-5 py-7 no-underline sm:gap-8">
              <span class="grid size-12 place-items-center rounded-full bg-tint text-accent-ink transition-colors group-hover:bg-accent group-hover:text-on-accent"><Icon name={p.icon} size={24} /></span>
              <span>
                <span class="block text-[clamp(1.1rem,0.85rem+1.02vw,1.78rem)] font-bold tracking-tight text-ink transition-transform duration-500 ease-[var(--ease-spring)] group-hover:translate-x-2">{p.title}</span>
                <span class="mt-1 block text-ink-3">{p.text}</span>
              </span>
              <Icon name="external" size={28} class="text-ink-3 transition-all duration-500 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-accent" />
            </a>
          </li>
        ))}
      </ul>

      <a href={lessonHref(lang, "B3")} class="glow group relative mt-16 grid items-center gap-8 overflow-hidden rounded-3xl bg-rose-600 p-8 text-white no-underline sm:p-12 lg:grid-cols-[1.3fr_1fr]" data-reveal>
        <div>
          <p class="flex items-center gap-2 text-sm font-semibold text-rose-100"><Icon name="siren" size={20} />{h.befast.tag}</p>
          <p class="mt-3 text-[clamp(1.44rem,1.02rem+1.53vw,2.38rem)] font-extrabold leading-tight tracking-tight">{h.befast.title}</p>
          <span class="btn btn-light mt-7 !text-rose-700">{h.befast.cta}<Icon name="arrow" size={18} weight="bold" /></span>
        </div>
        <div class="grid grid-cols-6 gap-2" aria-hidden="true">
          {["B", "E", "F", "A", "S", "T"].map((l, i) => (
            <span class="grid aspect-[3/4] place-items-center rounded-2xl bg-white/12 text-3xl font-extrabold transition-transform duration-500 group-hover:-translate-y-2" style={`transition-delay:${i * 40}ms`}>{l}</span>
          ))}
        </div>
      </a>
    </div>
  </section>
<script>
  // Roadmap carousel: native scroll-snap for swipe, buttons + dots, auto-advance every 5s.
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-road]");
    const track = root?.querySelector<HTMLElement>("[data-road-track]");
    if (!root || !track || root.dataset.ready) return;
    root.dataset.ready = "1";
    const slides = [...track.querySelectorAll<HTMLElement>("li[aria-roledescription=slide]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-road-dot]")];
    const prev = document.querySelector<HTMLButtonElement>("[data-road-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-road-next]");
    const pad = () => parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    const current = () => {
      if (atEnd()) return slides.length - 1;
      const x = track.scrollLeft + pad();
      let best = 0;
      slides.forEach((s, i) => { if (Math.abs(s.offsetLeft - x) < Math.abs(slides[best].offsetLeft - x)) best = i; });
      return best;
    };
    // idx is the source of truth; near the end several cards fit, so the scroll clamps but idx still steps 1 by 1
    let idx = 0, auto = false;
    const paint = () => dots.forEach((d, i) => d.setAttribute("aria-current", String(i === idx)));
    const go = (i: number) => {
      idx = (i + slides.length) % slides.length;
      auto = true;
      track.scrollTo({ left: Math.min(slides[idx].offsetLeft - pad(), track.scrollWidth - track.clientWidth) });
      paint();
    };
    const settle = () => { if (!auto) { idx = current(); paint(); } auto = false; };
    if ("onscrollend" in window) track.addEventListener("scrollend", settle);
    else { let t = 0; track.addEventListener("scroll", () => { clearTimeout(t); t = window.setTimeout(settle, 120); }, { passive: true }); }
    paint();

    let timer = 0;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const stop = () => clearInterval(timer);
    const start = () => { stop(); if (!reduce) timer = window.setInterval(() => go(idx + 1), 5000); };
    const user = (fn: () => void) => () => { fn(); start(); };
    prev?.addEventListener("click", user(() => go(idx - 1)));
    next?.addEventListener("click", user(() => go(idx + 1)));
    dots.forEach((d, i) => d.addEventListener("click", user(() => go(i))));
    root.addEventListener("pointerenter", stop);
    root.addEventListener("pointerleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);
    track.addEventListener("touchstart", stop, { passive: true });
    track.addEventListener("touchend", start, { passive: true });
    // only run while visible
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.3 }).observe(root);
    document.addEventListener("astro:before-swap", stop, { once: true });
  });
</script>
</Base>
