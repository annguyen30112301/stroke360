---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import Counter from "../components/Counter.astro";
import { getContent, href, pageHref, lessonHref, type PageKey } from "../lib/i18n";
import type { Lang } from "../content/types";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getContent(lang);
const h = c.home;
const BEFAST = ["B", "E", "F", "A", "S", "T"];
---
<Base lang={lang} page="home" path="" title={c.meta.home.title} description={c.meta.home.description}>
  <!-- 1. Promise -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -left-48 -top-48 size-[42rem] rounded-full bg-teal-300/25 blur-3xl dark:bg-teal-500/10"></div>
      <div class="absolute -right-40 top-32 size-[30rem] rounded-full bg-rose-300/20 blur-3xl dark:bg-rose-500/10"></div>
      <svg class="absolute bottom-0 left-1/2 w-[140%] max-w-none -translate-x-1/2 text-teal-500/10" viewBox="0 0 1200 200" fill="none" preserveAspectRatio="none">
        <path d="M0 140 C 200 60, 380 200, 600 120 S 1000 40, 1200 110" stroke="currentColor" stroke-width="2" />
        <path d="M0 170 C 240 100, 420 220, 640 150 S 1020 80, 1200 150" stroke="var(--color-rose-500)" stroke-opacity=".12" stroke-width="2" />
      </svg>
    </div>
    <div class="wrap grid items-center gap-14 pb-20 pt-12 sm:pt-20 lg:grid-cols-[1.25fr_1fr] lg:pb-28">
      <div>
        <span class="eyebrow anim-in"><Icon name="heart" size={18} />{h.eyebrow}</span>
        <h1 class="h-display anim-in mt-6" style="--d:1">
          {h.h1[0]} <span class="text-gradient">{h.h1[1]}</span> {h.h1[2]}
          <span class="mt-2 block text-muted/90 [font-weight:700]">{h.h1[3]}</span>
        </h1>
        <p class="lead anim-in mt-7 max-w-xl" style="--d:2" set:html={h.lead} />
        <div class="anim-in mt-9 flex flex-wrap gap-3" style="--d:3">
          <a class="btn btn-primary" href="#vi-sao">{h.cta1}<Icon name="arrow" size={18} weight="bold" /></a>
          <a class="btn btn-ghost" href={pageHref(lang, "dichVu", "#chon-goi")}>{h.cta2}</a>
        </div>
      </div>

      <!-- Diary notification mockup -->
      <div class="anim-in relative mx-auto w-full max-w-md" style="--d:3">
        <div class="floaty">
          <div class="overflow-hidden rounded-[1.75rem] border border-line bg-surface shadow-[var(--shadow-lift)]">
            <div class="flex items-center justify-between bg-gradient-to-r from-teal-700 to-teal-500 px-5 py-4 text-white">
              <span class="flex items-center gap-2 font-semibold"><Icon name="notebook" size={22} />{h.diary.head}</span>
              <span class="rounded-full bg-white/20 px-2.5 py-0.5 text-sm font-semibold tabular-nums">{h.diary.time}</span>
            </div>
            <ul class="grid gap-3 p-5">
              {h.diary.lines.map((l, i) => (
                <li class="anim-in flex gap-3" style={`--d:${4 + i * 2}`}>
                  <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-brand-soft text-brand"><Icon name="check" size={14} weight="bold" /></span>
                  <span class="text-[0.95rem]" set:html={l} />
                </li>
              ))}
            </ul>
            <div class="border-t border-line bg-sunken/60 px-5 py-4 text-sm text-muted">
              {h.diary.foot} <a href={pageHref(lang, "nhatKy")} class="font-semibold">{h.diary.more} →</a>
              <div class="note mt-1">{c.ui.simulated}</div>
            </div>
          </div>
        </div>
        <div class="anim-in absolute -left-4 -top-5 hidden rotate-[-4deg] items-center gap-2 rounded-2xl border border-line bg-surface px-3.5 py-2 text-sm font-semibold shadow-[var(--shadow-card)] sm:flex" style="--d:8">
          <Icon name="shield" size={20} class="text-brand" />0 {lang === "vi" ? "sự cố" : "incidents"}
        </div>
        <div class="anim-in absolute -bottom-5 -right-3 hidden rotate-[3deg] items-center gap-2 rounded-2xl border border-line bg-surface px-3.5 py-2 text-sm font-semibold shadow-[var(--shadow-card)] sm:flex" style="--d:10">
          <Icon name="clock" size={20} class="text-rose-500" />{lang === "vi" ? "Ca 12 giờ" : "12-hour shifts"}
        </div>
      </div>
    </div>
  </section>
  <div class="ribbon"></div>

  <!-- 2. Story -->
  <section id="vi-sao" class="section">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <span class="eyebrow">{h.story.eyebrow}</span>
        <h2 class="h-section mt-4">{h.story.title}</h2>
        <p class="note mt-4">{h.story.note}</p>
      </div>
      <div>
        <ol class="relative grid gap-10 pl-10">
          <span aria-hidden="true" class="absolute bottom-2 left-[0.6875rem] top-2 w-0.5 rounded bg-line"></span>
          <span aria-hidden="true" class="story-line absolute bottom-2 left-[0.6875rem] top-2 w-0.5 rounded bg-gradient-to-b from-teal-500 to-rose-500"></span>
          {h.story.steps.map(([time, text]) => (
            <li class="relative" data-reveal>
              <span aria-hidden="true" class="absolute -left-10 top-1 grid size-6 place-items-center rounded-full border-2 border-brand bg-bg"><span class="size-2 rounded-full bg-brand"></span></span>
              <p class="text-sm font-bold uppercase tracking-wider text-brand">{time}</p>
              <p class="mt-2 text-lg text-muted">{text}</p>
            </li>
          ))}
        </ol>
        <blockquote class="relative mt-12 rounded-[var(--radius-card)] bg-gradient-to-br from-teal-700 to-teal-900 p-8 text-white shadow-[var(--shadow-lift)] sm:p-10" data-reveal>
          <Icon name="quote" size={40} weight="fill" class="text-rose-300" />
          <p class="mt-3 text-xl font-semibold leading-snug sm:text-2xl">{h.story.quote}</p>
        </blockquote>
        <p class="mt-8 text-lg font-medium" data-reveal>{h.story.after}</p>
      </div>
    </div>
  </section>

  <!-- 3. Facts -->
  <section class="section bg-sunken">
    <div class="wrap">
      <SectionHead title={h.facts.title} />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {h.facts.items.map((f, i) => (
          <div class="card-flat flex flex-col" data-reveal style={`animation-delay:${i * 60}ms`}>
            <div class:list={["font-extrabold tracking-tight", f.word ? "text-brand text-4xl" : "text-rose-500 text-4xl sm:text-5xl"]}>
              {f.word ?? <Counter value={f.v!} lang={lang} prefix={f.p} suffix={f.s} />}
            </div>
            <p class="mt-3 text-muted">{f.text}</p>
          </div>
        ))}
      </div>
      <p class="note mt-6">{h.facts.source}</p>
    </div>
  </section>

  <!-- 4. Compare -->
  <section class="section">
    <div class="wrap">
      <SectionHead title={h.compare.title} sub={h.compare.sub} />
      <div class="card overflow-hidden !p-0" data-reveal>
        <div class="hidden grid-cols-2 sm:grid">
          <div class="px-6 py-4 font-bold text-muted">{h.compare.left}</div>
          <div class="bg-gradient-to-r from-teal-700 to-teal-500 px-6 py-4 font-bold text-white">{h.compare.right}</div>
        </div>
        {h.compare.rows.map(([a, b]) => (
          <div class="grid border-t border-line sm:grid-cols-2 sm:first-of-type:border-t-0">
            <div class="flex items-start gap-3 px-6 py-4 text-muted">
              <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-sunken text-faint"><Icon name="x" size={14} weight="bold" /></span>
              <span><span class="sr-only">{h.compare.left}: </span>{a}</span>
            </div>
            <div class="flex items-start gap-3 bg-brand-soft/60 px-6 py-4 font-medium">
              <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-brand text-on-brand"><Icon name="check" size={14} weight="bold" /></span>
              <span><span class="sr-only">{h.compare.right}: </span>{b}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Pillars -->
  <section class="section bg-brand-soft/50">
    <div class="wrap">
      <SectionHead title={h.pillars.title} sub={h.pillars.sub} />
      <div class="grid gap-5 md:grid-cols-3">
        {h.pillars.items.map((p, i) => (
          <a href={pageHref(lang, p.page as PageKey)} class="card card-link group flex flex-col" data-reveal>
            <span class:list={["icon-tile", i === 1 && "alert"]}><Icon name={p.icon} size={30} /></span>
            <h3 class="mt-5 text-xl">{p.title}</h3>
            <p class="mt-2 flex-1 text-[0.95rem] text-muted">{p.text}</p>
            <span class="mt-5 inline-flex items-center gap-2 font-semibold text-brand">{p.cta}<Icon name="arrow" size={18} weight="bold" class="transition-transform group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Values -->
  <section class="section">
    <div class="wrap">
      <SectionHead title={h.values.title} />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {h.values.items.map((v, i) => (
          <div class="card relative overflow-hidden" data-reveal>
            <span aria-hidden="true" class:list={["absolute inset-x-0 top-0 h-1", i % 2 ? "bg-rose-500" : "bg-teal-500"]}></span>
            <span class:list={["icon-tile", i % 2 && "alert"]}><Icon name={v.icon} size={28} /></span>
            <h3 class="mt-5 text-lg">{v.title}</h3>
            <p class="mt-2 text-[0.92rem] text-muted">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Team -->
  <section class="section bg-sunken">
    <div class="wrap">
      <SectionHead title={h.team.title} />
      <div class="grid gap-4 sm:grid-cols-2">
        {h.team.people.map((p) => (
          <div class="card flex items-center gap-4" data-reveal>
            <span class="grid size-16 shrink-0 place-items-center rounded-full bg-gradient-to-br from-teal-500 to-rose-500 text-2xl font-extrabold text-white">
              {p.initial || <Icon name="sparkle" size={26} />}
            </span>
            <div><h3 class="text-lg">{p.name}</h3><p class="text-sm text-muted">{p.role}</p></div>
          </div>
        ))}
        <div class="card flex items-center gap-4" data-reveal>
          <span class="grid size-16 shrink-0 place-items-center rounded-full bg-teal-800 text-white"><Icon name="seal" size={30} /></span>
          <div><h3 class="text-lg">{h.team.advisor.name}</h3><p class="text-sm text-muted">{h.team.advisor.role}</p></div>
        </div>
      </div>
      <p class="mt-6 max-w-3xl text-muted">{h.team.note}</p>
    </div>
  </section>

  <!-- 8. Roadmap -->
  <section class="section">
    <div class="wrap">
      <SectionHead title={h.road.title} sub={h.road.sub} />
      <div class="relative">
        <span aria-hidden="true" data-reveal-bar class="absolute left-0 right-0 top-3 hidden h-0.5 rounded bg-gradient-to-r from-teal-500 to-rose-500 lg:block"></span>
        <ol class="grid gap-6 lg:grid-cols-4">
          {h.road.items.map(([y, t, d], i) => (
            <li class="relative" data-reveal>
              <span aria-hidden="true" class:list={["relative z-10 hidden size-6 rounded-full border-4 border-bg lg:block", i === 3 ? "bg-rose-500" : "bg-teal-500"]}></span>
              <div class="card mt-0 lg:mt-5">
                <p class:list={["text-sm font-bold uppercase tracking-wider", i === 3 ? "text-rose-500" : "text-brand"]}>{y}</p>
                <h3 class="mt-1 text-xl">{t}</h3>
                <p class="mt-2 text-[0.92rem] text-muted">{d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 9. Paths + BE-FAST -->
  <section class="section bg-brand-soft/50">
    <div class="wrap">
      <SectionHead title={h.paths.title} />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {h.paths.items.map((p) => (
          <a href={href(lang, p.href)} class="card card-link group" data-reveal>
            <span class="icon-tile"><Icon name={p.icon} size={28} /></span>
            <h3 class="mt-4 text-lg">{p.title}</h3>
            <p class="mt-1 flex items-center gap-1.5 text-sm text-muted">{p.text}<Icon name="arrow" size={16} weight="bold" class="text-brand transition-transform group-hover:translate-x-1" /></p>
          </a>
        ))}
      </div>

      <div class="relative mt-10 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-rose-600 to-rose-700 p-8 text-white shadow-[var(--shadow-lift)] sm:p-12" data-reveal>
        <div aria-hidden="true" class="absolute -right-20 -top-24 size-80 rounded-full bg-white/10 blur-2xl"></div>
        <div class="relative grid items-center gap-8 lg:grid-cols-[1.2fr_1fr]">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3.5 py-1.5 text-sm font-semibold"><Icon name="siren" size={18} />{h.befast.tag}</span>
            <h3 class="mt-4 text-3xl font-extrabold !text-white sm:text-4xl">{h.befast.title}</h3>
            <a href={lessonHref(lang, "B3")} class="btn mt-6 bg-white text-rose-700 hover:bg-rose-50">{h.befast.cta}<Icon name="arrow" size={18} weight="bold" /></a>
          </div>
          <div class="grid grid-cols-6 gap-2" aria-hidden="true">
            {BEFAST.map((l, i) => (
              <span class="anim-in grid aspect-square place-items-center rounded-2xl bg-white/15 text-2xl font-extrabold backdrop-blur sm:text-3xl" style={`--d:${i}`}>{l}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
