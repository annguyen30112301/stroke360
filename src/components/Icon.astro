---
/* Phosphor duotone icons, rendered to static SVG at build time (no JS shipped). */
import { BookOpenTextIcon, UsersThreeIcon, StethoscopeIcon, ShieldCheckIcon, EyeIcon, HandHeartIcon, FirstAidKitIcon, BedIcon, HospitalIcon, IdentificationBadgeIcon, BrainIcon, PathIcon, HeartHalfIcon, CalendarCheckIcon, GlobeHemisphereEastIcon, UsersFourIcon, ChatCircleDotsIcon, PhoneIcon, ArrowRightIcon, ArrowLeftIcon, ArrowUpRightIcon, CheckIcon, XIcon, ClockIcon, SealCheckIcon, PrinterIcon, MagnifyingGlassIcon, HeartbeatIcon, SirenIcon, QuotesIcon, MapPinIcon, EnvelopeIcon, ListIcon, LightningIcon, PlayIcon, SparkleIcon, TargetIcon, TrendUpIcon, MedalIcon, NotebookIcon, TranslateIcon, ChatsCircleIcon, WarningIcon, PlantIcon } from "@phosphor-icons/react/ssr";

const map = {
  book: BookOpenTextIcon, community: UsersThreeIcon, care: StethoscopeIcon, shield: ShieldCheckIcon, eye: EyeIcon,
  handHeart: HandHeartIcon, scope: FirstAidKitIcon, bed: BedIcon, hospital: HospitalIcon, nurse: IdentificationBadgeIcon,
  brain: BrainIcon, path: PathIcon, heart: HeartHalfIcon, calendar: CalendarCheckIcon, globe: GlobeHemisphereEastIcon,
  family: UsersFourIcon, chat: ChatCircleDotsIcon, phone: PhoneIcon, arrow: ArrowRightIcon, back: ArrowLeftIcon,
  external: ArrowUpRightIcon, check: CheckIcon, x: XIcon, clock: ClockIcon, seal: SealCheckIcon, print: PrinterIcon,
  search: MagnifyingGlassIcon, pulse: HeartbeatIcon, siren: SirenIcon, quote: QuotesIcon, pin: MapPinIcon, mail: EnvelopeIcon,
  menu: ListIcon, bolt: LightningIcon, play: PlayIcon, sparkle: SparkleIcon, target: TargetIcon, trend: TrendUpIcon,
  medal: MedalIcon, notebook: NotebookIcon, lang: TranslateIcon, chats: ChatsCircleIcon, warn: WarningIcon, plant: PlantIcon
} as const;
export type IconName = keyof typeof map;

interface Props { name: IconName | string; size?: number; weight?: "duotone" | "bold" | "regular" | "fill"; class?: string; label?: string }
const { name, size = 24, weight = "duotone", class: cls, label } = Astro.props;
const C = map[name as IconName] ?? SparkleIcon;
---
<C size={size} weight={weight} className={cls} aria-hidden={label ? undefined : "true"} aria-label={label} role={label ? "img" : undefined} />
