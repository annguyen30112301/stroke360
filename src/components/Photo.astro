---
/* Uses public/images/<name>.jpg when present; otherwise a brand-tinted slot (see README: "Ảnh"). */
import fs from "node:fs";
import path from "node:path";
import Icon from "./Icon.astro";
import { asset } from "../lib/i18n";

interface Props { name: string; alt: string; class?: string; icon?: string; eager?: boolean; vt?: string }
const { name, alt, class: cls, icon = "heart", eager, vt } = Astro.props;
const file = path.join(process.cwd(), "public/images", `${name}.jpg`);
const exists = fs.existsSync(file);
---
{exists ? (
  <img src={asset(`images/${name}.jpg`)} alt={alt} class:list={["object-cover", cls]} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} decoding="async" style={vt ? `view-transition-name:${vt}` : undefined} />
) : (
  <div role="img" aria-label={alt} class:list={["relative grid place-items-center overflow-hidden bg-gradient-to-br from-teal-600 via-teal-700 to-teal-900", cls]} data-photo-slot={name}>
    <div aria-hidden="true" class="absolute -right-16 -top-16 size-64 rounded-full bg-teal-300/25 blur-2xl"></div>
    <div aria-hidden="true" class="absolute -bottom-20 -left-10 size-72 rounded-full bg-teal-400/20 blur-3xl"></div>
    <Icon name={icon} size={96} class="relative text-white/35" />
  </div>
)}
